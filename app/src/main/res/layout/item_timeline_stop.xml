<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <!-- Timeline Column -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:id="@+id/timelineLineTop"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@color/divider"/>

        <View
            android:id="@+id/timelineNode"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/circle_node"/>

        <View
            android:id="@+id/timelineLineBottom"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@color/divider"/>
    </LinearLayout>

    <!-- Stop Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/stopNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stop Name"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/scheduledTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduled: 06:40"
                android:textColor="@color/textSecondary"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/etaValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Waiting..."
                android:textColor="@color/statusWaiting"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
